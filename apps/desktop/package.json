{
  "name": "@tnega/desktop",
  "version": "0.5.4",
  "private": true,
  "description": "Tnega desktop, a local agent workspace.",
  "author": "whale4rain <153174302+whale4rain@users.noreply.github.com>",
  "homepage": "https://github.com/whale4rain/tnega",
  "desktopName": "tnega.desktop",
  "type": "module",
  "main": "out/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "pnpm --workspace-root build && pnpm build && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "package": "pnpm --workspace-root build && pnpm build && electron-builder"
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "@tnega/browser": "workspace:*",
    "@tnega/browser-playwright": "workspace:*",
    "@tnega/cli": "workspace:*",
    "@tnega/execution": "workspace:*",
    "electron-updater": "^6.8.9",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "optionalDependencies": {
    "koffi": "^3.1.0",
    "@lydell/node-pty-win32-x64": "1.1.0",
    "@lydell/node-pty-darwin-arm64": "1.1.0",
    "@lydell/node-pty-darwin-x64": "1.1.0",
    "@lydell/node-pty-linux-x64": "1.1.0"
  }
}
