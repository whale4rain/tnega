    "./project-local": {
      "types": "./dist/types/packages/project/project-local/src/index.d.ts",
      "import": "./dist/project-local.js"
    },
    "./memory": {
      "types": "./dist/types/packages/memory/memory/src/index.d.ts",
      "import": "./dist/memory.js"
    },
    "./memory-local": {
      "types": "./dist/types/packages/memory/memory-local/src/index.d.ts",
      "import": "./dist/memory-local.js"
    },
    "./subagent": {
      "types": "./dist/types/packages/subagent/subagent/src/index.d.ts",
      "import": "./dist/subagent.js"
