    },
    "./search-ripgrep": {
      "types": "./dist/types/packages/search/search-ripgrep/src/index.d.ts",
      "import": "./dist/search-ripgrep.js"
    },
    "./services": {
      "types": "./dist/types/src/services.d.ts",
      "import": "./dist/services.js"
    },
    "./spill": {
      "types": "./dist/types/packages/spill/spill/src/index.d.ts",
      "import": "./dist/spill.js"
    },
    "./spill-local": {
      "types": "./dist/types/packages/spill/spill-local/src/index.d.ts",
      "import": "./dist/spill-local.js"
    },
    "./tool-spill": {
      "types": "./dist/types/packages/spill/tool-spill/src/index.d.ts",
      "import": "./dist/tool-spill.js"
    },
    "./session": {
      "types": "./dist/types/packages/session/src/index.d.ts",
      "import": "./dist/session.js"
    },
    "./tool-search": {
      "types": "./dist/types/packages/search/tool-search/src/index.d.ts",
      "import": "./dist/tool-search.js"
    },
    "./tool-memory": {
      "types": "./dist/types/packages/memory/tool-memory/src/index.d.ts",
      "import": "./dist/tool-memory.js"
    },
    "./tools": {
      "types": "./dist/types/packages/tools/src/index.d.ts",
      "import": "./dist/tools.js"
    },
    "./cli": "./dist/bin.js",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "tnega": "node --disable-warning=ExperimentalWarning --experimental-strip-types --experimental-transform-types --experimental-loader ./scripts/ts-import-loader.mjs scripts/tnega.ts",
    "test": "vitest run",
    "test:package": "pnpm build && vitest run test/publish.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "prepublishOnly": "pnpm test:package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "tnega": "^0.1.1"
  }
}
