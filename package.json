{
  "name": "tnega",
  "version": "0.2.0",
  "description": "A minimal eval-first agent harness with spacetime-composable plugin lifecycles.",
  "private": false,
  "license": "MIT",
  "bin": {
    "tnega": "./dist/bin.js"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/types/packages/agent/src/index.d.ts",
      "import": "./dist/agent.js"
    },
    "./cli/runtime": {
      "types": "./dist/types/packages/cli/src/index.d.ts",
      "import": "./dist/cli-runtime.js"
    },
    "./coding-agent": {
      "types": "./dist/types/packages/coding-agent/src/index.d.ts",
      "import": "./dist/coding-agent.js"
    },
    "./core": {
      "types": "./dist/types/packages/core/src/index.d.ts",
      "import": "./dist/core.js"
    },
    "./eval": {
      "types": "./dist/types/packages/eval/src/index.d.ts",
      "import": "./dist/eval.js"
    },
    "./events": {
      "types": "./dist/types/src/events.d.ts",
      "import": "./dist/events.js"
    },
    "./evolve": {
      "types": "./dist/types/packages/evolve/src/index.d.ts",
      "import": "./dist/evolve.js"
    },
    "./llm": {
      "types": "./dist/types/packages/llm/src/index.d.ts",
      "import": "./dist/llm.js"
    },
    "./services": {
      "types": "./dist/types/src/services.d.ts",
      "import": "./dist/services.js"
    },
    "./session": {
      "types": "./dist/types/packages/session/src/index.d.ts",
      "import": "./dist/session.js"
    },
    "./tools": {
      "types": "./dist/types/packages/tools/src/index.d.ts",
      "import": "./dist/tools.js"
    },
    "./cli": "./dist/bin.js",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "tnega": "node --disable-warning=ExperimentalWarning --experimental-strip-types --experimental-transform-types --experimental-loader ./scripts/ts-import-loader.mjs scripts/tnega.ts",
    "test": "vitest run",
    "test:package": "pnpm build && vitest run test/publish.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "prepublishOnly": "pnpm test:package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "tnega": "^0.1.1"
  }
}
