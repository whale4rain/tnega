{
  "name": "tnega",
  "version": "0.4.2",
  "description": "A minimal eval-first agent harness with spacetime-composable plugin lifecycles.",
  "private": false,
  "license": "MIT",
  "bin": {
    "tnega": "./dist/bin.js"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/types/packages/agent/src/index.d.ts",
      "import": "./dist/agent.js"
    },
    "./artifact-store": {
      "types": "./dist/types/packages/project/artifact-store/src/index.d.ts",
      "import": "./dist/artifact-store.js"
    },
    "./artifact-local": {
      "types": "./dist/types/packages/project/artifact-local/src/index.d.ts",
      "import": "./dist/artifact-local.js"
    },
    "./cli/runtime": {
      "types": "./dist/types/packages/cli/src/index.d.ts",
      "import": "./dist/cli-runtime.js"
    },
    "./blackboard": {
      "types": "./dist/types/packages/project/blackboard/src/index.d.ts",
      "import": "./dist/blackboard.js"
    },
    "./blackboard-local": {
      "types": "./dist/types/packages/project/blackboard-local/src/index.d.ts",
      "import": "./dist/blackboard-local.js"
    },
    "./box": {
      "types": "./dist/types/packages/project/box/src/index.d.ts",
      "import": "./dist/box.js"
    },
    "./box-blackboard": {
      "types": "./dist/types/packages/project/box-blackboard/src/index.d.ts",
      "import": "./dist/box-blackboard.js"
    },
    "./coding-agent": {
      "types": "./dist/types/packages/coding-agent/src/index.d.ts",
      "import": "./dist/coding-agent.js"
    },
    "./core": {
      "types": "./dist/types/packages/core/src/index.d.ts",
      "import": "./dist/core.js"
    },
    "./eval": {
      "types": "./dist/types/packages/eval/src/index.d.ts",
      "import": "./dist/eval.js"
    },
    "./events": {
      "types": "./dist/types/src/events.d.ts",
      "import": "./dist/events.js"
    },
    "./evolve": {
      "types": "./dist/types/packages/evolve/src/index.d.ts",
      "import": "./dist/evolve.js"
    },
    "./execution": {
      "types": "./dist/types/packages/execution/src/index.d.ts",
      "import": "./dist/execution.js"
