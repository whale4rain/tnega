{
  "name": "tnega",
  "version": "0.1.0",
  "description": "A minimal eval-first agent harness with spacetime-composable plugin lifecycles.",
  "private": false,
  "license": "MIT",
  "bin": {
    "tnega": "./dist/bin.js"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": "./dist/bin.js",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "tnega": "node --disable-warning=ExperimentalWarning --experimental-strip-types --experimental-transform-types --experimental-loader ./scripts/ts-import-loader.mjs scripts/tnega.ts",
    "test": "vitest run",
    "test:package": "pnpm build && vitest run test/publish.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "prepublishOnly": "pnpm test:package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
